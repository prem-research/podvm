{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:confidential-containers:podvm:launch-profiles",
  "title": "CoCo PodVM launch profiles",
  "type": "object",
  "required": ["profiles", "tdx", "sev"],
  "properties": {
    "tdx": {
      "type": "object",
      "required": ["acpi_distribution", "qemu_source_version", "qemu"],
      "properties": {
        "acpi_distribution": {"type": "string", "minLength": 1},
        "qemu_source_version": {"type": "string", "minLength": 1},
        "qemu": {"$ref": "#/$defs/tdxQemu"}
      },
      "additionalProperties": false
    },
    "sev": {
      "type": "object",
      "required": ["qemu", "defaults"],
      "properties": {
        "qemu": {"$ref": "#/$defs/snpQemu"},
        "defaults": {"$ref": "#/$defs/snpSettings", "required": ["vcpu_types", "vmm_type", "guest_features"]}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/profileId"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "memory": {"type": "string", "pattern": "^[1-9][0-9]*[MG]$"},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gpu": {
      "type": "object",
      "required": ["family", "platform", "count", "nvswitch_count"],
      "properties": {
        "family": {"enum": ["H100", "H200", "B200", "B300"]},
        "platform": {"enum": ["pcie", "hgx-hopper", "hgx-blackwell"]},
        "count": {"enum": [1, 8]},
        "nvswitch_count": {"enum": [0, 4]}
      },
      "additionalProperties": false
    },
    "tdxTopology": {
      "type": "object",
      "required": ["numa", "objects", "bridges", "endpoints", "synthetic_devices", "qemu_globals", "fw_cfg", "mmio_apertures"],
      "properties": {
        "numa": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "objects": {"$ref": "#/$defs/stringArray"},
        "bridges": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "endpoints": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "synthetic_devices": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "qemu_globals": {"$ref": "#/$defs/stringArray"},
        "fw_cfg": {"$ref": "#/$defs/stringArray"},
        "mmio_apertures": {
          "type": "object",
          "required": ["below_4g", "above_4g"],
          "properties": {
            "below_4g": {"$ref": "#/$defs/memory"},
            "above_4g": {"$ref": "#/$defs/memory"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tdxQemu": {
      "type": "object",
      "required": [
        "measurement_machine",
        "runtime_machine",
        "cpu",
        "accel",
        "measurement_objects",
        "runtime_objects",
        "netdevs",
        "measurement_netdevs",
        "measurement_devices",
        "runtime_devices"
      ],
      "properties": {
        "measurement_machine": {"type": "string", "minLength": 1},
        "runtime_machine": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "accel": {"type": "string", "minLength": 1},
        "measurement_objects": {"$ref": "#/$defs/stringArray"},
        "runtime_objects": {"$ref": "#/$defs/stringArray"},
        "netdevs": {"$ref": "#/$defs/stringArray"},
        "measurement_netdevs": {"$ref": "#/$defs/stringArray"},
        "measurement_devices": {"$ref": "#/$defs/stringArray"},
        "runtime_devices": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "snpQemu": {
      "type": "object",
      "required": ["machine", "memory_backend", "guest", "netdevs", "runtime_devices"],
      "properties": {
        "machine": {"type": "string", "minLength": 1},
        "memory_backend": {
          "type": "object",
          "required": ["id", "share", "prealloc"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "share": {"type": "boolean"},
            "prealloc": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "guest": {
          "type": "object",
          "required": ["id", "cbitpos", "reduced_phys_bits", "kernel_hashes"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "cbitpos": {"type": "integer"},
            "reduced_phys_bits": {"type": "integer"},
            "kernel_hashes": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "netdevs": {"$ref": "#/$defs/stringArray"},
        "runtime_devices": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false
    },
    "vcpuType": {
      "type": "string",
      "enum": [
        "EPYC",
        "EPYC-Genoa",
        "EPYC-Genoa-v1",
        "EPYC-IBPB",
        "EPYC-Milan",
        "EPYC-Milan-v1",
        "EPYC-Milan-v2",
        "EPYC-Rome",
        "EPYC-Rome-v1",
        "EPYC-Rome-v2",
        "EPYC-Rome-v3",
        "EPYC-Turin",
        "EPYC-v1",
        "EPYC-v2",
        "EPYC-v3",
        "EPYC-v4"
      ]
    },
    "snpSettings": {
      "type": "object",
      "properties": {
        "vcpu_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/vcpuType"}},
        "vmm_type": {"const": "QEMU"},
        "guest_features": {"type": "string", "pattern": "^0x[0-9a-f]+$"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["cpus", "memory"],
      "dependentRequired": {"tdx_topology": ["gpu"]},
      "properties": {
        "cpus": {"type": "integer", "minimum": 1, "maximum": 255},
        "memory": {"$ref": "#/$defs/memory"},
        "sev": {"$ref": "#/$defs/snpSettings"},
        "gpu": {"$ref": "#/$defs/gpu"},
        "tdx_topology": {"$ref": "#/$defs/tdxTopology"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
