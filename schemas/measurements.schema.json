{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:confidential-containers:podvm:measurements:v1",
  "title": "CoCo PodVM measurements",
  "type": "object",
  "required": ["schema", "schema_version", "release", "artifact", "inputs", "profiles", "rvps"],
  "properties": {
    "schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": 1},
    "release": {
      "type": "object",
      "required": ["version", "source_repository", "source_revision"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["name", "sha256", "media_type"],
      "properties": {
        "name": {"type": "string", "pattern": "^podvm-ubuntu-24\\.04-x86_64-.+\\.tar\\.zst$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"const": "application/zstd"}
      },
      "additionalProperties": false
    },
    "inputs": {"type": "object"},
    "profiles": {
      "type": "object",
      "required": ["tdx", "sev_snp"],
      "properties": {
        "tdx": {
          "type": "object",
          "required": ["boot", "measurement"],
          "properties": {
            "boot": {"type": "object"},
            "measurement": {
              "type": "object",
              "required": ["mr_td", "rtmr_0", "rtmr_1", "rtmr_2"],
              "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{96}$"}
            }
          }
        },
        "sev_snp": {
          "type": "object",
          "required": ["boot", "measurement"],
          "properties": {
            "boot": {"type": "object"},
            "measurement": {"type": "string", "pattern": "^[0-9a-f]{96}$"}
          }
        }
      }
    },
    "rvps": {
      "type": "object",
      "required": ["reference_values"],
      "properties": {
        "reference_values": {
          "type": "object",
          "required": ["mr_td", "rtmr_0", "rtmr_1", "rtmr_2", "snp_launch_measurement"],
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[0-9a-f]{96}$"}
          }
        }
      }
    }
  },
  "additionalProperties": false
}
