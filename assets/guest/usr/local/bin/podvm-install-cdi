#!/bin/sh
set -eu

# /var can be a fresh tmpfs. Do not probe sources: the agent initializes
# Init-Data after this installer, and containers must explicitly select it.
mkdir -p /var/run/cdi
temporary=$(mktemp /var/run/cdi/.podvm-metadata.XXXXXX)
trap 'rm -f "$temporary"' 0
trap 'exit 1' HUP INT TERM
cat /usr/share/podvm/cdi/metadata.yaml > "$temporary"
chown 0:0 "$temporary"
chmod 0644 "$temporary"
mv -fT "$temporary" /var/run/cdi/podvm-metadata.yaml
