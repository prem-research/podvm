#!/bin/sh
set -eu

# This directory is deliberately separate from the unprivileged daemon's state.
install -d -m 0700 -o 0 -g 0 /run/podvm-time
install -d -m 0750 -o _chrony -g _chrony /run/chrony
daemon_pid=
cleanup() {
    if [ -n "$daemon_pid" ]; then
        kill "$daemon_pid" 2>/dev/null || :
        wait "$daemon_pid" 2>/dev/null || :
    fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

has_nameserver() {
    [ -f /etc/resolv.conf ] || return 1
    while read -r key _ || [ -n "$key" ]; do
        [ "$key" = nameserver ] && return 0
    done < /etc/resolv.conf
    return 1
}

# The agent writes guest DNS after boot, once the shim has configured the
# network. chronyd retries a failed name lookup only after 28 seconds, beyond
# the agent's 30-second admission window, so do not start it any earlier.
until has_nameserver; do
    sleep 0.1
done

while :; do
    # A crash must not re-enable startup steps after containers were admitted.
    set --
    if [ -f /run/podvm-time/ready ]; then
        set -- -R
    fi
    # -d keeps chronyd in the foreground and logs to stderr, i.e. the console.
    /usr/sbin/chronyd -d -F 1 -f /etc/chrony/chrony.conf "$@" &
    daemon_pid=$!
    while kill -0 "$daemon_pid" 2>/dev/null; do
        if [ ! -f /run/podvm-time/ready ] &&
            /usr/bin/chronyc -h /run/chrony/chronyd.sock waitsync 1 0.1 0 1 > /dev/null 2>&1; then
            # Disable any remaining automatic steps before publishing readiness.
            if /usr/bin/chronyc -h /run/chrony/chronyd.sock makestep 0.1 0 > /dev/null 2>&1; then
                : > /run/podvm-time/ready
                echo 'podvm-time: initial authenticated synchronization completed' >&2
            fi
        fi
        sleep 1
    done
    status=0
    wait "$daemon_pid" || status=$?
    daemon_pid=
    echo "podvm-time: chronyd exited ($status); restarting in one second" >&2
    sleep 1
done
