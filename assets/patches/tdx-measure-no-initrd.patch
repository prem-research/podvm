+    fn absent_initrd_measures_only_command_line() {
+        let cmdline = "root=/dev/dm-0 ro";
+        assert_eq!(measure_rtmr2_direct(None, cmdline).unwrap(),
+            measure_log(&[crate::util::measure_cmdline(cmdline)]));
+    }
+    #[test]
+    fn present_initrd_preserves_original_events() {
+        let file = tempfile::NamedTempFile::new().unwrap();
+        std::fs::write(file.path(), b"initrd regression fixture").unwrap();
+        let cmdline = "root=/dev/dm-0 ro";
+        assert_eq!(measure_rtmr2_direct(Some(file.path().to_str().unwrap()), cmdline).unwrap(),
+            measure_log(&[crate::util::measure_cmdline(&(cmdline.to_string() + " initrd=initrd")),
+                measure_sha384(b"initrd regression fixture")]));
+    }
+}
