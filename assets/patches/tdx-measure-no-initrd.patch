+        assert!(args.windows(2).any(|a| a == ["--user", "0:0"]));
+        assert!(args.windows(2).any(|a| a == ["--device", "/dev/kvm:/dev/kvm"]));
+        assert!(args.windows(2).any(|a| a == ["--device", "/dev/vhost-vsock:/dev/vhost-vsock"]));
+        assert!(!args.contains(&"--privileged"));
+        assert!(!args.contains(&"--group-add"));
+        assert!(args.contains(&"/workspace/OVMF.fd:/usr/share/ovmf/OVMF.fd:ro"));
+        assert!(args.contains(&"/workspace/acpi-output:/output"));
+        assert_eq!(&args[args.len() - 2..],
+            &["-device", "vhost-vsock-pci,guest-cid=3,disable-modern=false"]);
