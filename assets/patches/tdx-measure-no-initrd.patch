+        let args = build_qemu_args(Some(&shape), 2, "8G");
+        let args: Vec<&str> = args.iter().map(|s| s.to_str().unwrap()).collect();
+        let disk = args.iter().position(|v| *v == "-blockdev").unwrap();
+        let console = args.iter().position(|v| *v == "-chardev").unwrap();
+        let device = args.iter().position(|v| *v == "-device").unwrap();
+        assert!(disk < device && console < device);
+        assert_eq!(args[console + 1], "null,id=charconsole0");
+        assert_eq!(args[disk + 1], "driver=null-co,node-name=root,size=1048576,read-only=on");
+    }
+}
