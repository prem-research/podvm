 /// Measures RTMR2 for direct boot from file paths.
 pub(crate) fn measure_rtmr2_direct(
-    initrd_path: &str,
+    initrd_path: Option<&str>,
     kernel_cmdline: &str,
 ) -> Result<Vec<u8>> {
 
-    // Reads our initrd file
-    let initrd_data = fs::read(initrd_path).context("Failed to read initrd file")?;
-
-    // OVFM adds initrd to the command line
-    let cmdline = kernel_cmdline.to_string() + " initrd=initrd";
-
-    // Compute RTMR2 log
-    let rtmr2_log = vec![
-        crate::util::measure_cmdline(&cmdline),
-        measure_sha384(&initrd_data),
-    ];
+    // Firmware measures the initrd and appends its name only when present.
+    let mut rtmr2_log = match initrd_path {
+        Some(_) => vec![crate::util::measure_cmdline(&(kernel_cmdline.to_string() + " initrd=initrd"))],
+        None => vec![crate::util::measure_cmdline(kernel_cmdline)],
+    };
+    if let Some(path) = initrd_path {
+        rtmr2_log.push(measure_sha384(&fs::read(path).context("Failed to read initrd file")?));
+    }
 
     debug_print_log("RTMR2", &rtmr2_log);
     Ok(measure_log(&rtmr2_log))
 }
