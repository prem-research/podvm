+fn check_placement(ctr: &LinuxContainer) -> anyhow::Result<std::path::PathBuf> {
+    let pid = ctr.init_process_pid;
+    let manager_dir = std::path::PathBuf::from(
+        ctr.cgroup_manager
+            .as_ref()
+            .get_cgroup_path("")
+            .context("reading the container's cgroup manager path")?,
+    );
+    let proc_cgroup = std::fs::read_to_string(format!("/proc/{pid}/cgroup"))?;
+    let (dir, expected) = net_policy::resolve_cgroup_dir(&manager_dir, &proc_cgroup)?;
+    let cgroup_procs = std::fs::read_to_string(dir.join("cgroup.procs"))?;
+    net_policy::verify_placement(&expected, &proc_cgroup, &cgroup_procs, pid)?;
+    Ok(dir)
+}
