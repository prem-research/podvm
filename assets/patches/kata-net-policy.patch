+/// Socket rules for network-policy containers, in separate stacked filters: added to the OCI
+/// profile's filter, its generic socket allow would take precedence.
+pub fn init_podvm_network_seccomp() -> Result<()> {
+    #[allow(deprecated)]
+    const SOCK_PACKET: i32 = libc::SOCK_PACKET;
+    let socket = ScmpSyscall::from_name("socket")?;
+    // Families and types need separate filters: libseccomp 2.5.4 miscompiles them combined
+    // (it denied AF_UNIX SOCK_SEQPACKET, which CUDA's cuInit opens).
+    // Allow Unix, IP and netlink (getifaddrs). The cgroup hooks see only IP, so this is what stops
+    // AF_VSOCK and AF_PACKET. libseccomp can't test one argument twice per rule, hence a deny per
+    // other family.
+    let mut families = podvm_socket_filter()?;
+    const ALLOWED_FAMILIES: [i32; 4] = [libc::AF_UNIX, libc::AF_INET, libc::AF_INET6, libc::AF_NETLINK];
+    for family in 0..=libc::AF_NETLINK {
+        if !ALLOWED_FAMILIES.contains(&family) {
+            families.add_rule_conditional(
+                ScmpAction::Errno(libc::EPERM),
+                socket,
+                &[ScmpArgCompare::new(0, ScmpCompareOp::Equal, family as u64)],
+            )?;
+        }
+    }
+    families.add_rule_conditional(
+        ScmpAction::Errno(libc::EPERM),
+        socket,
+        &[ScmpArgCompare::new(0, ScmpCompareOp::Greater, libc::AF_NETLINK as u64)],
+    )?;
+    let mut types = podvm_socket_filter()?;
+    // AF_NETLINK keeps SOCK_RAW: getifaddrs(3) needs it, and NCCL/Gloo need getifaddrs.
+    // The 0xf mask strips SOCK_CLOEXEC/SOCK_NONBLOCK from the type.
+    types.add_rule_conditional(
+        ScmpAction::Errno(libc::EPERM),
+        socket,
+        &[
+            ScmpArgCompare::new(1, ScmpCompareOp::MaskedEqual(0xf), libc::SOCK_RAW as u64),
+            ScmpArgCompare::new(0, ScmpCompareOp::NotEqual, libc::AF_NETLINK as u64),
+        ],
+    )?;
+    // The kernel turns socket(AF_INET, SOCK_PACKET, ...) into a packet socket the cgroup hooks
+    // never see.
+    types.add_rule_conditional(
+        ScmpAction::Errno(libc::EPERM),
+        socket,
+        &[ScmpArgCompare::new(1, ScmpCompareOp::MaskedEqual(0xf), SOCK_PACKET as u64)],
+    )?;
+    families.load()?;
+    types.load()?;
+    Ok(())
+}
+
+fn podvm_socket_filter() -> Result<ScmpFilterContext> {
+    let mut filter = ScmpFilterContext::new_filter(ScmpAction::Allow)?;
+    // A non-native ABI (e.g. socketcall) would bypass the socket() rules.
+    filter.set_act_badarch(ScmpAction::KillProcess)?;
+    // Loading sets no_new_privs when needed, so this works after capabilities are dropped.
+    Ok(filter)
+}
