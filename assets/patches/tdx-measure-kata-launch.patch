+
+    #[test]
+    fn every_referenced_drive_gets_a_backend_and_smp_can_be_explicit() {
+        let shape = QemuShape {
+            machine: "q35".into(), cpu: "host".into(), accel: "kvm".into(),
+            globals: vec![], objects: vec![], netdevs: vec![], numa: vec![],
+            smp: Some("16,cores=1,threads=1".into()), fw_cfg: vec![],
+            devices: vec!["virtio-blk-pci,drive=image-1,share-rw=on".into(),
+                "virtio-blk-pci,drive=initdata".into(),
+                "virtio-blk-pci,drive=image-1".into()],
+        };
+        let args = build_qemu_args(Some(&shape), 16, "768G");
+        let args: Vec<&str> = args.iter().map(|s| s.to_str().unwrap()).collect();
+        let smp = args.iter().position(|v| *v == "-smp").unwrap();
+        assert_eq!(args[smp + 1], "16,cores=1,threads=1");
+        let backends: Vec<&str> = args.windows(2)
+            .filter(|w| w[0] == "-blockdev").map(|w| w[1]).collect();
+        assert_eq!(backends, vec![
+            "driver=null-co,node-name=image-1,size=1048576,read-only=on",
+            "driver=null-co,node-name=initdata,size=1048576,read-only=on",
+        ]);
+        let first_device = args.iter().position(|v| *v == "-device").unwrap();
+        assert!(args.iter().rposition(|v| *v == "-blockdev").unwrap() < first_device);
+    }
