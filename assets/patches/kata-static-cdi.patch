+
+#[cfg(test)]
+mod static_cdi_tests {
+    use super::*;
+    use serde_json::json;
+    use std::os::unix::fs::PermissionsExt;
+    use std::path::Path;
+    use tempfile::tempdir;
+
+    fn write_spec(directory: &Path, kind: &str, name: &str, edits: serde_json::Value) {
+        fs::create_dir_all(directory).unwrap();
+        fs::write(
+            directory.join("device.json"),
+            json!({
+                "cdiVersion": "0.6.0",
+                "kind": kind,
+                "devices": [{ "name": name, "containerEdits": edits }]
+            })
+            .to_string(),
+        )
+        .unwrap();
+    }
+
+    fn metadata_edits() -> serde_json::Value {
+        json!({ "mounts": [{
+            "hostPath": "/run/confidential-containers/initdata/initdata.toml",
+            "containerPath": "/run/podvm/initdata.toml",
+            "type": "bind",
+            "options": ["bind", "ro", "nosuid", "nodev", "noexec"]
+        }] })
+    }
+
+    async fn inject(static_dir: &Path, runtime_dir: &Path, selector: &str) -> Result<Spec> {
+        let logger = slog::Logger::root(slog::Discard, o!());
+        let mut spec = Spec::default();
+        let mut process = oci::Process::default();
+        process.set_env(Some(vec![format!("VISIBLE_CDI_DEVICES={selector}")]));
+        spec.set_process(Some(process));
+        let devices = cdi_devices_from_visible_devices(&spec)?;
+        handle_cdi_devices(
+            &logger,
+            &mut spec,
+            Some(static_dir.to_str().unwrap()),
+            runtime_dir.to_str().unwrap(),
+            Duration::ZERO,
+            &devices,
+        )
+        .await?;
+        Ok(spec)
+    }
+
+    #[tokio::test]
+    async fn static_and_runtime_specs_are_selected_independently() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        write_spec(&static_dir, "podvm.local/metadata", "all", metadata_edits());
+        write_spec(
+            &runtime_dir,
+            "nvidia.com/gpu",
+            "0",
+            json!({ "env": ["GPU_SELECTED=1"] }),
+        );
+
+        for (selector, metadata, gpu) in [
+            ("", false, false),
+            ("podvm.local/metadata=all", true, false),
+            ("nvidia.com/gpu=0", false, true),
+            ("podvm.local/metadata=all:nvidia.com/gpu=0", true, true),
+        ] {
+            let spec = inject(&static_dir, &runtime_dir, selector).await.unwrap();
+            let mount = spec
+                .mounts()
+                .as_ref()
+                .unwrap()
+                .iter()
+                .find(|m| m.destination() == Path::new("/run/podvm/initdata.toml"));
+            assert_eq!(mount.is_some(), metadata, "{selector}");
+            if let Some(mount) = mount {
+                assert_eq!(
+                    mount.source().as_deref(),
+                    Some(Path::new(
+                        "/run/confidential-containers/initdata/initdata.toml"
+                    ))
+                );
+                assert_eq!(
+                    mount.options().as_ref().unwrap(),
+                    &["bind", "ro", "nosuid", "nodev", "noexec"]
+                );
+            }
+            let env = spec.process().as_ref().unwrap().env().as_ref().unwrap();
+            assert_eq!(env.iter().any(|v| v == "GPU_SELECTED=1"), gpu, "{selector}");
+        }
+    }
+
+    #[tokio::test]
+    async fn static_spec_needs_no_runtime_directory_or_source_file() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        // Init-Data source is checked at container creation, not here.
+        write_spec(&static_dir, "podvm.local/metadata", "all", metadata_edits());
+        fs::set_permissions(
+            static_dir.join("device.json"),
+            fs::Permissions::from_mode(0o444),
+        )
+        .unwrap();
+        let spec = inject(&static_dir, &runtime_dir, "podvm.local/metadata=all")
+            .await
+            .unwrap();
+        assert!(spec
+            .mounts()
+            .as_ref()
+            .unwrap()
+            .iter()
+            .any(|m| { m.destination() == Path::new("/run/podvm/initdata.toml") }));
+        assert!(
+            !runtime_dir.exists(),
+            "static CDI must not require runtime installation"
+        );
+    }
+
+    #[tokio::test]
+    async fn runtime_spec_works_without_static_directory() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        write_spec(
+            &runtime_dir,
+            "nvidia.com/gpu",
+            "0",
+            json!({ "env": ["GPU_SELECTED=1"] }),
+        );
+        let spec = inject(&static_dir, &runtime_dir, "nvidia.com/gpu=0")
+            .await
+            .unwrap();
+        assert!(spec
+            .process()
+            .as_ref()
+            .unwrap()
+            .env()
+            .as_ref()
+            .unwrap()
+            .iter()
+            .any(|v| v == "GPU_SELECTED=1"));
+        assert!(!static_dir.exists());
+    }
+
+    #[tokio::test]
+    async fn measured_kinds_are_never_redefined_at_runtime() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        write_spec(&static_dir, "podvm.local/metadata", "all", metadata_edits());
+        write_spec(
+            &runtime_dir,
+            "podvm.local/metadata",
+            "all",
+            json!({ "mounts": [{
+                "hostPath": "/",
+                "containerPath": "/host",
+                "type": "bind",
+                "options": ["bind", "rw"]
+            }], "env": ["CDI_ORIGIN=runtime"] }),
+        );
+        let spec = inject(&static_dir, &runtime_dir, "podvm.local/metadata=all")
+            .await
+            .unwrap();
+        let mounts = spec.mounts().as_ref().unwrap();
+        assert!(mounts
+            .iter()
+            .any(|m| m.destination() == Path::new("/run/podvm/initdata.toml")));
+        assert!(!mounts.iter().any(|m| m.destination() == Path::new("/host")));
+        assert!(!spec
+            .process()
+            .as_ref()
+            .unwrap()
+            .env()
+            .as_ref()
+            .unwrap()
+            .iter()
+            .any(|v| v == "CDI_ORIGIN=runtime"));
+    }
+
+    #[tokio::test]
+    async fn measured_kind_with_unknown_device_fails_without_waiting() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        write_spec(&static_dir, "podvm.local/metadata", "all", metadata_edits());
+        write_spec(&runtime_dir, "podvm.local/metadata", "1", metadata_edits());
+        let error = inject(&static_dir, &runtime_dir, "podvm.local/metadata=1")
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("do not exist"), "{:#}", error);
+    }
+
+    #[tokio::test]
+    async fn runtime_kinds_are_not_served_from_the_measured_directory() {
+        let root = tempdir().unwrap();
+        let static_dir = root.path().join("etc/cdi");
+        let runtime_dir = root.path().join("var/run/cdi");
+        write_spec(&static_dir, "podvm.local/metadata", "all", metadata_edits());
+        write_spec(
+            &runtime_dir,
+            "nvidia.com/gpu",
+            "0",
+            json!({ "env": ["CDI_ORIGIN=runtime"] }),
+        );
+        let spec = inject(&static_dir, &runtime_dir, "nvidia.com/gpu=0")
+            .await
+            .unwrap();
+        let env = spec.process().as_ref().unwrap().env().as_ref().unwrap();
+        assert!(env.iter().any(|v| v == "CDI_ORIGIN=runtime"));
+    }
+}
