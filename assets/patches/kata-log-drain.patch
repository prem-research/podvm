+    async fn read_or_discard_stream(
+        &self,
+        req: &protocols::agent::ReadStreamRequest,
+        stdout: bool,
+    ) -> Result<protocols::agent::ReadStreamResponse> {
+        if is_allowed(req).await.is_err() {
+            // Policy does not allow reading logs. Redacting each read to empty
+            // data makes the shim treat it as EOF and stop reading, and the
+            // workload then blocks once the pipe fills. Discard the output here
+            // instead, and return empty data only at the stream's real EOF.
+            while !self.do_read_stream(req, stdout).await?.data.is_empty() {}
+            return Ok(protocols::agent::ReadStreamResponse::new());
+        }
+        self.do_read_stream(req, stdout).await
+    }
