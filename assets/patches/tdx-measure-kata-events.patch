+    /// RTMR0 as Kata's OVMF-tdx logs it with `-kernel`: fw_cfg BootMenu and bootorder,
+    /// SMBIOS, and two boot options are measured in addition to the common events.
+    fn rtmr0_kata(&self, machine: &Machine, td_hob_hash: Vec<u8>, cfv_hash: Vec<u8>, acpi: [Vec<u8>; 3]) -> Result<Vec<u8>> {
+        let smbios_path = machine.smbios.context("Kata measurement requires boot_config.smbios")?;
+        let processor_id = machine.smbios_processor_id.map(hex::decode).transpose()
+            .context("boot_config.smbios_processor_id must be hex")?;
+        let smbios = crate::smbios::firmware_table(&read_file_data(smbios_path)?, processor_id.as_deref())?;
+        let [acpi_loader_hash, acpi_rsdp_hash, acpi_tables_hash] = acpi;
+        let rtmr0_log = vec![
+            td_hob_hash,
+            cfv_hash,
+            measure_sha384(&[0x00, 0x00]), // fw_cfg BootMenu
+            measure_sha384(b"/rom@genroms/linuxboot_dma.bin\0"), // fw_cfg bootorder (-kernel)
+            measure_tdx_efi_variable("8BE4DF61-93CA-11D2-AA0D-00E098032B8C", "SecureBoot", None)?,
+            measure_tdx_efi_variable("8BE4DF61-93CA-11D2-AA0D-00E098032B8C", "PK", None)?,
+            measure_tdx_efi_variable("8BE4DF61-93CA-11D2-AA0D-00E098032B8C", "KEK", None)?,
+            measure_tdx_efi_variable("D719B2CB-3D3A-4596-A3BC-DAD00E67656F", "db", None)?,
+            measure_tdx_efi_variable("D719B2CB-3D3A-4596-A3BC-DAD00E67656F", "dbx", None)?,
+            measure_sha384(&[0x00, 0x00, 0x00, 0x00]), // Separator
+            acpi_loader_hash,
+            acpi_rsdp_hash,
+            acpi_tables_hash,
+            measure_sha384(&crate::smbios::filtered(&smbios)?),
+            measure_sha384(&KATA_BOOT_ORDER),
+            measure_sha384(&hex::decode(KATA_BOOT0000)?),
+            measure_sha384(&hex::decode(KATA_BOOT0001)?),
+        ];
+        debug_print_log("RTMR0", &rtmr0_log);
+        Ok(measure_log(&rtmr0_log))
+    }
