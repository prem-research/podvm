diff --git a/src/smbios.rs b/src/smbios.rs
new file mode 100644
index 0000000..06e375d
--- /dev/null
+++ b/src/smbios.rs
@@ -0,0 +1,127 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+//! SMBIOS measurement of Kata's OVMF-tdx (edk2-stable202511 SmbiosMeasurementDxe).
+use anyhow::{bail, Context, Result};
+
+// (type, offset, size, is_string) fields the firmware blanks before hashing.
+const FILTER: &[(u8, usize, usize, bool)] = &[
+    (1, 0x07, 1, true), (1, 0x08, 16, false), (1, 0x18, 1, false),
+    (2, 0x07, 1, true), (2, 0x0A, 1, true),
+    (3, 0x07, 1, true), (3, 0x08, 1, true),
+    (4, 0x20, 1, true), (4, 0x21, 1, true), (4, 0x22, 1, true), (4, 0x23, 1, false),
+    (4, 0x24, 1, false), (4, 0x25, 1, false), (4, 0x2A, 2, false), (4, 0x2C, 2, false),
+    (4, 0x2E, 2, false), (4, 0x11, 1, false), (4, 0x16, 2, false),
+    (17, 0x18, 1, true), (17, 0x19, 1, true), (17, 0x1A, 1, true),
+    (22, 0x0E, 1, true), (22, 0x11, 2, false), (22, 0x13, 2, false),
+    (23, 0x0D, 2, false),
+    (27, 0x0C, 2, false),
+    (39, 0x07, 1, true), (39, 0x08, 1, true), (39, 0x09, 1, true),
+];
+// Types zeroed after the 4-byte header; OEM types (>= 128) are too.
+const ZERO_ALL: &[u8] = &[0x0B, 0x0F, 0x12, 0x1F, 0x21];
+// OVMF's Type 0 ("EDK II", "unknown", "02/02/2022") and its end-of-table structure.
+const OVMF_TYPE0_AND_END: &str = "001a0000010200e803000800000000000000001c0000ffff0000\
+45444b20494900756e6b6e6f776e0030322f30322f3230323200007f04fffe0000";
+
+/// Offset one past the structure at `off` (formatted area, strings, double NUL).
+fn structure_end(table: &[u8], off: usize) -> Result<usize> {
+    let length = *table.get(off + 1).context("truncated SMBIOS structure")? as usize;
+    let mut pos = off + length;
+    while pos + 1 < table.len() {
+        if table[pos] == 0 && table[pos + 1] == 0 {
+            return Ok(pos + 2);
+        }
+        pos += 1;
+    }
+    bail!("unterminated SMBIOS structure at offset {off}")
+}
+
+/// The table the firmware installs from QEMU's `etc/smbios/smbios-tables`: QEMU's structures
+/// without its end marker, then OVMF's Type 0 and end marker. `processor_id` replaces the
+/// host-specific Type 4 ProcessorId (CPUID.1 EAX, EDX as the TD sees them).
+pub(crate) fn firmware_table(qemu: &[u8], processor_id: Option<&[u8]>) -> Result<Vec<u8>> {
+    let mut table = Vec::with_capacity(qemu.len() + 64);
+    let mut off = 0;
+    while off < qemu.len() && qemu[off] != 127 {
+        let end = structure_end(qemu, off)?;
+        let start = table.len();
+        table.extend_from_slice(&qemu[off..end]);
+        if let (4, Some(id)) = (qemu[off], processor_id) {
+            if id.len() != 8 || qemu[off + 1] < 16 {
+                bail!("SMBIOS processor id must be 8 bytes");
+            }
+            table[start + 8..start + 16].copy_from_slice(id);
+        }
+        off = end;
+    }
+    table.extend_from_slice(&hex::decode(OVMF_TYPE0_AND_END)?);
+    Ok(table)
+}
+
+/// Applies the firmware's measurement filter.
+pub(crate) fn filtered(table: &[u8]) -> Result<Vec<u8>> {
+    let mut t = table.to_vec();
+    let mut off = 0;
+    while off < t.len() {
+        let (typ, length) = (t[off], t[off + 1] as usize);
+        let end = structure_end(&t, off)?;
+        let mut strings = Vec::new();
+        let mut pos = off + length;
+        while t[pos] != 0 {
+            let len = t[pos..end].iter().position(|b| *b == 0).unwrap_or(0);
+            strings.push((pos, len));
+            pos += len + 1;
+        }
+        if ZERO_ALL.contains(&typ) || typ >= 128 {
+            t[off + 4..end].fill(0);
+        }
+        for &(_, field, size, is_string) in FILTER.iter().filter(|f| f.0 == typ) {
+            if length < field + size {
+                continue;
+            }
+            let id = t[off + field] as usize;
+            if is_string && id != 0 {
+                let &(start, len) = strings.get(id - 1).context("SMBIOS string id out of range")?;
+                t[start..start + len].fill(b' ');
+            }
+            t[off + field..off + field + size].fill(0);
+        }
+        off = end;
+        if typ == 127 {
+            break;
+        }
+    }
+    Ok(t)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replaces_qemu_end_marker_and_processor_id() {
+        let mut qemu = vec![4u8, 16, 0, 4];
+        qemu.extend_from_slice(&[0; 12]);
+        qemu.extend_from_slice(b"CPU 0\0\0");
+        qemu.extend_from_slice(&[127, 4, 0, 0x7f, 0, 0]);
+        let table = firmware_table(&qemu, Some(&[1, 2, 3, 4, 5, 6, 7, 8])).unwrap();
+        assert_eq!(&table[8..16], &[1, 2, 3, 4, 5, 6, 7, 8]);
+        assert!(table.ends_with(&[0x7f, 0x04, 0xff, 0xfe, 0, 0]));
+        assert_eq!(table[23], 0); // OVMF Type 0 follows the Type 4 structure
+    }
+
+    #[test]
+    fn filter_blanks_strings_and_zeroes_fields() {
+        // Type 1, length 27: serial number is string 2, UUID at 0x08.
+        let mut t = vec![1u8, 27, 0, 1, 1, 0, 0, 2];
+        t.extend_from_slice(&[0xAA; 16]);
+        t.extend_from_slice(&[6, 0, 0]);
+        t.extend_from_slice(b"QEMU\0SN123\0\0");
+        let f = filtered(&t).unwrap();
+        assert_eq!(f[7], 0);
+        assert_eq!(&f[8..24], &[0; 16]);
+        assert_eq!(f[24], 0);
+        assert_eq!(&f[27..], b"QEMU\0     \0\0");
+    }
+}
